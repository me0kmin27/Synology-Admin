{
  "name": "synology-admin-internal",
  "services": {
    "db": {
      "restart": "unless-stopped",
      "cpus": "1.0",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "postgres:17-bookworm",
      "mem_limit": "768m",
      "shm_size": "128m",
      "environment": {
        "POSTGRES_DB": "portal",
        "POSTGRES_USER": "portal",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?Generate remote secrets first}"
      },
      "volumes": [
        "postgres_data:/var/lib/postgresql/data"
      ],
      "command": [
        "postgres",
        "-c",
        "shared_buffers=128MB",
        "-c",
        "max_connections=40"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U portal -d portal"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 12
      }
    },
    "web": {
      "restart": "unless-stopped",
      "cpus": "1.0",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "synology-admin-internal:${SOURCE_REVISION:?Set exact source commit}",
      "build": {
        "context": ".",
        "args": {
          "SOURCE_REVISION": "${SOURCE_REVISION:?Set exact source commit}"
        }
      },
      "mem_limit": "512m",
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": ["default", "frontend"],
      "ports": [
        "${INTERNAL_BIND_HOST:-127.0.0.1}:18080:8000"
      ],
      "environment": {
        "DJANGO_SECRET_KEY": "${DJANGO_SECRET_KEY:?Generate remote secrets first}",
        "MFA_ENCRYPTION_KEYS": "${MFA_ENCRYPTION_KEYS:?Generate independent remote MFA key first}",
        "DJANGO_ALLOWED_HOSTS": "localhost,127.0.0.1,${INTERNAL_BIND_HOST:-127.0.0.1}",
        "DJANGO_LOCAL_HTTP": "1",
        "OIDC_ENABLED": "${OIDC_ENABLED:-0}",
        "OIDC_ISSUER": "${OIDC_ISSUER:-}",
        "OIDC_CLIENT_ID": "${OIDC_CLIENT_ID:-}",
        "OIDC_CLIENT_SECRET": "${OIDC_CLIENT_SECRET:-}",
        "OIDC_REDIRECT_URI": "${OIDC_REDIRECT_URI:-}",
        "DJANGO_DB_ENGINE": "postgresql",
        "PGHOST": "db",
        "PGPORT": "5432",
        "PGDATABASE": "portal",
        "PGUSER": "portal",
        "PGPASSWORD": "${POSTGRES_PASSWORD:?Generate remote secrets first}"
      },
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import json,urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8000/health/',timeout=3); assert r.status == 200 and json.load(r)['database'] == 'ok'"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 4,
        "start_period": "20s"
      }
    }
  },
  "volumes": {
    "postgres_data": {}
  },
  "networks": {
    "frontend": {},
    "default": {
      "internal": true
    }
  }
}
