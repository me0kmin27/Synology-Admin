# Non-secret operator example, NOT automatically loaded.
# User-provided domain spelling retained; DNS host comparison is case-insensitive.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.14,Test.keiminem.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://Test.keiminem.com
DJANGO_TRUSTED_PROXY_IPS=192.168.1.142
INTERNAL_BIND_HOST=192.168.1.14
# Activate only after peer/header and both DNS routes are verified.
# 0 enables HTTPS redirects + Secure cookies. 1 is explicitly insecure LAN testing.
DJANGO_LOCAL_HTTP=0
