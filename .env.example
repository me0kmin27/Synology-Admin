# Documentation only. Not auto-loaded. Generate your own random secret.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# No proxy/origin trust by default. See docs/reverse-proxy.md for activation.
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Opt in ONLY for loopback local development; unset for secure defaults.
DJANGO_LOCAL_HTTP=1
# Optional absolute private runtime database path:
# DJANGO_DB_PATH=
# SQLite management mutations fail closed by default. Disposable local use ONLY:
# DJANGO_ALLOW_UNSAFE_SQLITE=1
# Concurrent/production membership requires PostgreSQL READ COMMITTED + DB sessions.
# DJANGO_DB_ENGINE=postgresql
# PGDATABASE=
# PGUSER=
# PGHOST=
# PGPORT=5432
# Supply PGPASSWORD from a runtime secret store when required; never commit it.

# Optional authentik OIDC. Disabled until provider + HTTPS deployment verified.
OIDC_ENABLED=0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Planned per-provider issuer (verify discovery before activation):
# OIDC_ISSUER=https://sso.keiminem.com/application/o/synology-admin/
# Exact strict callback: https://test.keiminem.com/auth/oidc/callback/
# See docs/authentik-oidc.md; do not enable with DJANGO_LOCAL_HTTP=1.
