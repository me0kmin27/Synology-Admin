# Documentation only. Not auto-loaded. Generate your own random secret.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Opt in ONLY for loopback local development; unset for secure defaults.
DJANGO_LOCAL_HTTP=1
# Optional absolute private runtime database path:
# DJANGO_DB_PATH=
# SQLite management mutations fail closed by default. Disposable local use ONLY:
# DJANGO_ALLOW_UNSAFE_SQLITE=1
# Concurrent/production membership requires PostgreSQL READ COMMITTED + DB sessions.
# DJANGO_DB_ENGINE=postgresql
# PGDATABASE=
# PGUSER=
# PGHOST=
# PGPORT=5432
# Supply PGPASSWORD from a runtime secret store when required; never commit it.
